# 비워 두면 같은 출처(/api)로 요청하고, 개발 서버가 VITE_PROXY_TARGET으로 넘긴다
VITE_API_BASE_URL=
# 개발 서버 프록시 대상 (백엔드 주소)
VITE_PROXY_TARGET=http://localhost:8080
# 백엔드에 아직 없는 API를 가짜로 응답 (src/mocks). 끄려면 false
VITE_ENABLE_MSW=true
# 백엔드에 전용 재시도 API가 생기면 true. 그 전에는 같은 질문을 다시 보내는 방식으로 대신한다
VITE_RETRY_API=false
# 카카오 지도 JavaScript 키 (developers.kakao.com 앱 키 > JavaScript 키). 그 앱의 플랫폼 > Web에 http://localhost:3000을 등록해야 한다
# 비워 두면 매장 화면이 간이 지도로 보이고, 역·장소 이름 검색이 꺼진다
VITE_KAKAO_MAP_KEY=
