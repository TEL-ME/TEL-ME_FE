# 비워 두면 같은 출처(/api)로 요청하고, 개발 서버가 VITE_PROXY_TARGET으로 넘긴다
VITE_API_BASE_URL=
# 개발 서버 프록시 대상 (백엔드 주소)
VITE_PROXY_TARGET=http://localhost:8080
# 백엔드에 아직 없는 API를 가짜로 응답 (src/mocks). 끄려면 false
VITE_ENABLE_MSW=true
# 사용량(/usage/me)을 최근 6개월 더미로 응답 (지난 달 화면 확인용, VITE_ENABLE_MSW가 켜져 있어야 한다). 실제 서버 값을 보려면 false
VITE_MOCK_USAGE=false
# 백엔드에 전용 재시도 API가 생기면 true. 그 전에는 같은 질문을 다시 보내는 방식으로 대신한다
VITE_RETRY_API=false
# 상담에서 지역을 되물을 때 "현재 위치 사용" 버튼을 보여 주고, 누르면 질문과 함께 위도·경도를 보낸다 (백엔드 TELME-103)
# 좌표를 받지 못하는 백엔드에 붙일 때만 false로 끈다
VITE_CHAT_GPS=true
# 카카오 지도 JavaScript 키 (developers.kakao.com 앱 > 플랫폼 키 > JavaScript 키)
# 그 키의 "JavaScript SDK 도메인"에 http://localhost:3000을 등록하고, 앱의 카카오맵 > 사용 설정을 ON으로 둬야 한다
# 비워 두면 매장 화면이 간이 지도로 보이고, 역·장소 이름 검색이 꺼진다
VITE_KAKAO_MAP_KEY=
# Sentry 오류 수집 (화면 오류 + API 5xx만). DSN을 비워 두면 수집하지 않는다
# 실제 DSN은 .env.local에만 넣는다
VITE_SENTRY_DSN=
# Sentry에서 구분할 환경 이름: 로컬은 local, 베타 서버는 beta
VITE_SENTRY_ENVIRONMENT=local
# GA4 측정 ID (비우면 사용자 행동을 수집하지 않음)
VITE_GA_MEASUREMENT_ID=
# true면 GA DebugView 확인용 디버그 모드 (로컬에서만)
VITE_GA_DEBUG=